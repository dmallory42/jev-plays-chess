{
  "name": "jev-plays-chess",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && vite web",
    "dev:api": "tsx scripts/dev-server.ts",
    "build": "node scripts/copy-assets.mjs && vite build web",
    "build:node": "esbuild deploy/node/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=deploy/node/dist/server.mjs",
    "start": "node deploy/node/dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && node deploy/spacefast/build.mjs && npx -y spacefast publish .deploy -y --wait"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "maia3-ts": "github:dmallory42/maia3-ts#v0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "stockfish": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
